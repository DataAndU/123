# Copy to .env for local dev; on DigitalOcean App Platform set these as
# encrypted app-level environment variables instead of committing a .env file.

PORT=4000
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/prosperity
DATABASE_SSL=false
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Real market data feed (optional). Leave MARKET_DATA_PROVIDER=simulated to run
# entirely on the built-in simulator. Set to "alphavantage" and supply a key
# (free at https://www.alphavantage.co/support/#api-key) to pull real quotes
# for the tickers configured in src/market/liveProvider.ts.
MARKET_DATA_PROVIDER=simulated
ALPHAVANTAGE_API_KEY=

# Real macro indicators (optional) via FRED (free key at https://fred.stlouisfed.org/docs/api/api_key.html).
# Set this and the economy tick will nudge unemployment/inflation/interest-rate
# toward the real US figures instead of running purely simulated.
FRED_API_KEY=

# Google Play Billing purchase verification (optional until you wire up a
# real Play Console app). See src/billing/playVerification.ts and the
# README's "Enabling real money purchases" section.
GOOGLE_PLAY_PACKAGE_NAME=com.prosperity.game
GOOGLE_SERVICE_ACCOUNT_JSON=

# NEVER set this to true outside of local development. It skips real Google
# Play purchase verification entirely and trusts whatever the client sends —
# fine for testing the coin-crediting logic, unsafe in production.
BILLING_DEV_MODE=false
