<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Mini JARVIS is offline-by-default: almost every feature below is backed
      by an on-device Android API and needs no network permission at all.
      The one exception is the optional local-AI-agent's internet tool (see
      net/WebFetchTool.kt) — INTERNET is a "normal" permission Android grants
      silently at install with no user-facing prompt, so the actual gate is
      entirely in-app: AssistantSettingsStore.isInternetAccessEnabled, off by
      default, and only switched on after an explicit warning dialog in
      Settings. No other code path in this app ever opens a socket.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice chat (on-device speech recognition + text-to-speech) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Image capture and on-device analysis -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Optional: call history module -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Optional: location/visit history module -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Optional: app usage statistics module (special access, granted via Settings) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Local reminder notifications, and the wake-word listening notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- "Whole phone" control: calls, texts, contact lookup for call-by-name -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Screen brightness control — a special permission granted via Settings, like PACKAGE_USAGE_STATS above -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- The always-listening wake-word service runs as a foreground service with a persistent notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!--
      Android 11+ package visibility: needed for "open <app>" to see every
      launchable app via PackageManager.queryIntentActivities, without the
      much broader QUERY_ALL_PACKAGES permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".core.MiniJarvisApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MiniJarvis"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MiniJarvis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Optional module: reads currently-playing media session metadata
          (title/artist only) purely on-device to build a local music
          history log. Requires the user to explicitly grant Notification
          Access in system Settings; disabled until then.
        -->
        <service
            android:name=".system.MusicListenerService"
            android:exported="true"
            android:label="@string/music_history_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Optional module: the "whole phone" control surface — reads on-screen
          text and performs taps/global navigation (home/back/screenshot/lock)
          only while the user has manually enabled this in system Settings.
          Android requires that manual step for every Accessibility Service;
          no app can turn this on for itself.
        -->
        <service
            android:name=".control.JarvisAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Optional module: always-listening wake word. A foreground service so
          the background microphone use is always visible via a persistent
          notification with a one-tap "Stop listening" action.
        -->
        <service
            android:name=".assistant.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".system.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Handles Allow/Deny taps on a background agent-confirmation notification. -->
        <receiver
            android:name=".llm.ConfirmationReceiver"
            android:exported="false" />

    </application>
</manifest>
